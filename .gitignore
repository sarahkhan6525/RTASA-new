# Secrets -- never commit real credentials
.env
.rtasa_master.key
.rtasa_session_secret
.rtasa_*secret*

# Runtime state -- generated fresh by `python cli.py serve` / `demo` / `test`,
# never part of the source
rtasa.db
*.db
security_events.log
*.log

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Node / frontend -- a second, newer React frontend was started here but
# has no package.json or build tooling yet, so it can't actually be built;
# the working, demoed UI is webui/index.html (served by app/main.py), not
# this one. Excluded from the repo for now so nothing published looks
# broken or unfinished -- it's still on disk locally, just not pushed.
node_modules/
frontend/

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Generated evaluation output
*.png
!webui/**/*.png
!docs/screenshots/**/*.png
steganalysis_auc.png
benchmark_latency.png
