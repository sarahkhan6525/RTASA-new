# Copy this file to `.env` in the same folder (project root, next to cli.py)
# and fill in the real values. `.env` is gitignored -- never commit it.
#
# Used by the Owner/Custodian/Requester portal login (app/email_otp.py) to
# send real sign-in codes by email. If these are left unset, the backend
# still runs fine -- only the new email-login flow will refuse with a
# clear "email isn't configured" error until you fill this in.

# --- Gmail SMTP (recommended: free, and you already have a Gmail address) ---
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
#    (NOT your real Gmail password -- a separate 16-character code just for this app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
# Optional -- defaults to SMTP_USERNAME if left out:
# SMTP_FROM=your-gmail-address@gmail.com
